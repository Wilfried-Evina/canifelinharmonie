---
import Icon from './Icon.astro';
import type { Price } from '../data/site';
interface Props {
  item: Price;
}
const { item } = Astro.props;
---

<article class:list={['price-card', { featured: item.featured }]}>
  {item.featured && <span class="badge">Le plus demandé</span>}
  <header>
    <h3>{item.name}</h3>
    <p class="duration"><Icon name="clock" size={16} /> {item.duration}</p>
  </header>
  <p class="price">
    <span class="cur">CHF</span>
    <span class="amount">{item.price}</span>
    <span class="unit">{item.unit}</span>
  </p>
  {item.extra && <p class="extra">{item.extra}</p>}
  <ul class="checklist">
    {
      item.features.map((f) => (
        <li>
          <Icon name="check" size={18} />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  {item.note && <p class="note">{item.note}</p>}
</article>

<style>
  .price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px 28px;
    box-shadow: var(--shadow-sm);
  }
  .price-card.featured {
    border-color: var(--teal-600);
    box-shadow:
      0 0 0 1px var(--teal-600),
      var(--shadow);
  }
  .badge {
    position: absolute;
    top: -13px;
    left: 28px;
    background: var(--teal-800);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: 999px;
  }
  h3 {
    margin: 0 0 6px;
  }
  .duration {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 22px 0 4px;
    color: var(--teal-950);
  }
  .cur {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .amount {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    font-weight: 450;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums;
  }
  .unit {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .extra {
    font-size: 0.88rem;
    color: #a3485a;
    margin: 0;
  }
  .note {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: 0.86rem;
    color: var(--muted);
  }
  .checklist {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px dashed var(--line);
    font-size: 0.96rem;
  }
</style>
