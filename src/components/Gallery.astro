---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  photos: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { photos } = Astro.props;
---

<ul class="gallery">
  {
    photos.map((p, i) => (
      <li style={`--r:${[-2.2, 1.6, -1, 2.4, -1.8, 1.2, -2.6, 1.8, -1.2][i % 9]}deg`}>
        <figure class="polaroid">
          <Image src={p.src} alt={p.alt} widths={[240, 480]} sizes="240px" loading="lazy" />
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 44%), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    }
  }
  li {
    transform: rotate(var(--r));
    transition: transform 0.35s var(--ease);
  }
  @media (hover: hover) {
    li:hover {
      transform: rotate(0deg) scale(1.03);
      z-index: 1;
    }
  }
  .polaroid :global(img) {
    aspect-ratio: 1;
  }
</style>
