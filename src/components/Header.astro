---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name}, accueil`}>
      <img src="/logo.svg" alt="" width="50" height="47" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">Canifelin Harmonie</span>
        <span class="brand-sub">Éducatrice canin · Intervenante en comportement</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul id="nav-list" class="nav-list" data-nav>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta-mobile">
          <a href="/contact" class="btn">Prendre rendez-vous</a>
          <a href={site.whatsapp} class="btn btn--ghost" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <a href="/contact" class="btn header-cta">Prendre rendez-vous</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-list" data-menu-toggle>
      <span class="sr-only">Ouvrir le menu</span>
      <Icon name="menu" class="i-open" size={28} />
      <Icon name="close" class="i-close" size={28} />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = toggle.querySelector('.sr-only')!;

  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  /* Fond flouté sur un calque à part : un backdrop-filter sur le header lui-même
     casserait le menu mobile en position fixe (bug Safari iOS) */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .is-open.site-header::before {
    background: var(--cream);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -18px rgb(15 44 61 / 0.4);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--teal-950);
    margin-right: auto;
  }
  .brand-logo {
    width: 50px;
    height: auto;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-size: 0.74rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .nav-list a:not(.btn) {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.97rem;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  @media (hover: hover) {
    .nav-list a:not(.btn):hover {
      background: var(--teal-50);
      color: var(--teal-900);
    }
  }
  .nav-list a[aria-current='page'] {
    background: var(--teal-100);
    color: var(--teal-900);
  }
  .nav-cta-mobile {
    display: none;
  }
  .header-cta {
    min-height: 44px;
    padding: 10px 20px;
    font-size: 0.95rem;
  }
  /* Jamais de libellé sur deux lignes dans la barre */
  .nav-list a,
  .header-cta {
    white-space: nowrap;
  }
  /* Écrans moyens (≈ 1024–1279 px) : barre plus compacte pour tout garder sur une ligne */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .bar {
      gap: 16px;
    }
    .brand-sub {
      display: none;
    }
    .nav-list {
      gap: 2px;
    }
    .nav-list a:not(.btn) {
      padding: 8px 10px;
      font-size: 0.94rem;
    }
    .header-cta {
      padding: 10px 16px;
      font-size: 0.9rem;
    }
  }

  /* Bouton menu : juste les 3 barres, sans fond ni bordure */
  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--teal-950);
    place-items: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-toggle :global(svg) {
    stroke-width: 2.2;
  }
  .menu-toggle :global(.i-close) {
    display: none;
  }
  .is-open .menu-toggle :global(.i-open) {
    display: none;
  }
  .is-open .menu-toggle :global(.i-close) {
    display: block;
  }

  @media (max-width: 1023px) {
    .menu-toggle {
      display: grid;
    }
    .header-cta {
      display: none;
    }
    .nav {
      position: fixed;
      top: 76px;
      left: 0;
      right: 0;
      height: calc(100vh - 76px);
      height: calc(100dvh - 76px);
      z-index: 49;
      background: var(--cream);
      padding: 16px var(--gutter) calc(32px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.22s var(--ease),
        transform 0.22s var(--ease),
        visibility 0s linear 0.22s;
    }
    .is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.22s var(--ease),
        transform 0.22s var(--ease);
    }
    .nav-list {
      flex-direction: column;
      gap: 0;
    }
    .nav-list a:not(.btn) {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 450;
      padding: 14px 4px;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
    }
    .nav-list a[aria-current='page'] {
      background: none;
      color: var(--teal-600);
    }
    .nav-cta-mobile {
      display: grid;
      gap: 10px;
      margin-top: 28px;
    }
  }
  /* Téléphones : la petite ligne passerait sur deux lignes, on ne garde que le nom */
  @media (max-width: 560px) {
    .brand-sub {
      display: none;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
