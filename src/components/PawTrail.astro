---
// Traces de pattes en dégradé vert → bleu, reprises de la carte de visite.
// Animation : les empreintes apparaissent une à une (comme une marche), puis s'effacent
// dans le même ordre, en boucle. Statique si l'utilisateur préfère réduire les animations.
interface Props {
  class?: string;
  count?: number;
  /** Opacité globale (ex. 0.15 sur fond sombre) */
  opacity?: number;
  /** Désactiver l'animation de marche */
  static?: boolean;
  /** Décalage de départ (s), pour ne pas synchroniser plusieurs traces d'une même page */
  delay?: number;
  /** Type d'empreinte : chien (doigts allongés, zigzag) ou chat (doigts ronds, marche en ligne) */
  animal?: 'dog' | 'cat';
  /** Couleur unique (ex. blanc sur fond coloré) au lieu du dégradé vert → bleu */
  color?: string;
}
const { class: cls, count = 4, opacity = 1, static: isStatic = false, delay = 0, animal = 'dog', color } = Astro.props;
const isCat = animal === 'cat';
const colors = ['#46b59c', '#3ea5b1', '#3896bf', '#3185c5', '#3185c5', '#3896bf'];
// Chien : zigzag large. Chat : pattes posées presque l'une devant l'autre, pas plus courts.
const gapY = isCat ? 48 : 58;
const gapX = isCat ? 24 : 46;
const tilt = isCat ? 6 : 14;
const paws = Array.from({ length: count }, (_, i) => ({
  x: (i % 2 === 0 ? 0 : gapX) + (isCat ? 12 : 0),
  y: (count - 1 - i) * gapY,
  color: color ?? colors[i % colors.length],
}));
const h = (count - 1) * gapY + 32;
const step = isCat ? 0.5 : 0.55; // secondes entre deux pas (le chat trottine un peu plus vite)
const duration = count * step + 2.6; // durée d'un cycle complet
---

<svg
  class:list={['paw-trail', cls, { walking: !isStatic }]}
  viewBox={`0 0 78 ${h}`}
  aria-hidden="true"
  style={`opacity:${opacity};--dur:${duration}s;--step:${step}s;--start:${delay}s`}
>
  {
    paws.map((p, i) => (
      <g fill={p.color} transform={`translate(${p.x} ${p.y}) rotate(${i % 2 ? tilt : -tilt} 16 16)`}>
        <g class="paw" style={`--i:${i}`}>
          {isCat ? (
            <>
              <g transform="translate(16 17) scale(1.12) translate(-16 -17)">
          <circle cx="7.6" cy="13.4" r="3.1" />
          <circle cx="12.4" cy="8.6" r="3.2" />
          <circle cx="19.6" cy="8.6" r="3.2" />
          <circle cx="24.4" cy="13.4" r="3.1" />
          <path d="M16 15.4c-4 0-8.2 3.4-8.2 7.2 0 2.1 1.3 3.6 3.1 3.9 1.1.2 1.9-.3 2.6-1 .7 1 1.5 1.7 2.5 1.7s1.8-.7 2.5-1.7c.7.7 1.5 1.2 2.6 1 1.8-.3 3.1-1.8 3.1-3.9 0-3.8-4.2-7.2-8.2-7.2z" />
        </g>
            </>
          ) : (
            <>
              <ellipse cx="7" cy="13" rx="3" ry="4" transform="rotate(-24 7 13)" />
              <ellipse cx="12.6" cy="6.4" rx="3.2" ry="4.3" transform="rotate(-8 12.6 6.4)" />
              <ellipse cx="19.4" cy="6.4" rx="3.2" ry="4.3" transform="rotate(8 19.4 6.4)" />
              <ellipse cx="25" cy="13" rx="3" ry="4" transform="rotate(24 25 13)" />
              <path d="M16 14.2c-4.4 0-9.2 6.4-9.2 10.4 0 3 2.6 4.6 5.2 4.1 1.5-.3 2.6-1 4-1s2.5.7 4 1c2.6.5 5.2-1.1 5.2-4.1 0-4-4.8-10.4-9.2-10.4z" />
            </>
          )}
        </g>
      </g>
    ))
  }
</svg>

<style>
  .paw-trail {
    pointer-events: none;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .walking .paw {
      transform-box: fill-box;
      transform-origin: 50% 70%;
      opacity: 0;
      animation: paw-step var(--dur) cubic-bezier(0.22, 1, 0.36, 1) infinite;
      animation-delay: calc(var(--start) + var(--i) * var(--step));
      will-change: opacity, transform;
    }
  }

  /*
   * Un pas = la patte se « pose » (léger écrasement puis taille normale),
   * reste visible un moment, puis s'efface doucement.
   */
  @keyframes paw-step {
    0% {
      opacity: 0;
      transform: scale(0.55) translateY(4px);
    }
    6% {
      opacity: 1;
      transform: scale(1.08);
    }
    11% {
      transform: scale(1);
    }
    55% {
      opacity: 1;
      transform: scale(1);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(0.92);
    }
  }
</style>
