---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="f-brand">
          <img src="/logo.svg" alt="" width="60" height="56" class="f-logo" />
          <span>Canifelin Harmonie</span>
        </a>
        <p>
          Éducation, comportement et garde à domicile pour chiens et chats à Genève. Une approche
          bienveillante, fondée sur la compréhension de l’animal.
        </p>
      </div>

      <div class="f-col">
        <h2 class="f-title">Prestations</h2>
        <ul class="f-list">
          <li><a href="/chien">Éducation & comportement du chien</a></li>
          <li><a href="/chat">Comportement du chat</a></li>
          <li><a href="/garde-a-domicile">Garde à domicile</a></li>
          <li><a href="/tarifs">Tarifs</a></li>
        </ul>
      </div>

      <div class="f-col">
        <h2 class="f-title">Infos</h2>
        <ul class="f-list">
          <li><a href="/qui-suis-je">Qui suis-je</a></li>
          <li><a href="/liens-utiles">Liens utiles</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="f-contact-col">
        <h2 class="f-title">Contact</h2>
        <ul class="f-list f-contact">
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="whatsapp" size={18} />
            <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp {site.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} target="_blank" rel="noopener">{site.street}<br />{site.postalCode} {site.base}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Canifelin Harmonie · {site.owner}</p>
      <ul>
        <li><a href="/conditions-d-utilisation">Conditions d’utilisation</a></li>
        <li><a href="/politique-de-confidentialite">Confidentialité</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--cream);
    color: var(--muted);
    padding-block: clamp(56px, 7vw, 88px) 28px;
    font-size: 0.95rem;
  }
  .footer-grid {
    display: grid;
    gap: 40px;
  }
  /* Mobile : marque et contact sur toute la largeur, Prestations | Infos côte à côte */
  @media (max-width: 759px) {
    .site-footer {
      padding-top: 36px;
      font-size: 0.9rem;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }
    .footer-grid {
      text-align: center;
    }
    .footer-brand,
    .f-contact-col {
      grid-column: 1 / -1;
    }
    .f-contact li {
      justify-content: center;
    }
    .f-contact li > span,
    .f-contact li > a {
      text-align: left;
    }
    .f-brand {
      font-size: 1.2rem;
      margin-bottom: 10px;
    }
    .f-logo {
      width: 46px;
    }
    .footer-brand p {
      margin: 0;
      max-width: none;
    }
    .f-title {
      margin-bottom: 10px;
    }
    .f-list {
      gap: 8px;
    }
    .footer-bottom {
      margin-top: 28px;
      padding-top: 16px;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 8px;
    }
  }
  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 0.8fr 1.3fr;
    }
  }
  .f-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--teal-950);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-bottom: 16px;
  }
  .f-logo {
    height: auto;
  }
  .footer-brand p {
    max-width: 36ch;
  }
  .f-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-700);
    margin-bottom: 16px;
  }
  .f-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .f-list a {
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  @media (hover: hover) {
    .f-list a:hover {
      color: var(--teal-700);
      text-decoration: underline;
    }
  }
  .f-contact li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  /* :global car l'icône est rendue par le composant Icon (styles scopés sinon ignorés) */
  .f-contact :global(svg) {
    flex: none;
    margin-top: 5px;
  }
  .footer-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.87rem;
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-bottom ul {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .footer-bottom a {
    color: var(--muted);
  }
</style>
