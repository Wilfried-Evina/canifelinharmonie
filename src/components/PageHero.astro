---
import PawTrail from './PawTrail.astro';
interface Props {
  /** Type de traces de pattes décoratives */
  paws?: 'dog' | 'cat';
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead, paws = 'dog' } = Astro.props;
---

<section class="page-hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">{eyebrow}</p>
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      Astro.slots.has('aside') ? (
        <div class="hero-aside">
          <slot name="aside" />
        </div>
      ) : (
        <div class="hero-aside hero-logo" aria-hidden="true">
          <img src="/logo.svg" alt="" width="320" height="301" />
        </div>
      )
    }
  </div>
  <PawTrail class="ph-paws" count={3} animal={paws} />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(56px, 7vw, 96px);
    background:
      radial-gradient(60% 80% at 100% 0%, var(--teal-50) 0%, transparent 70%),
      radial-gradient(40% 60% at 0% 100%, var(--apricot-soft) 0%, transparent 70%);
  }
  .page-hero :global(.ph-paws) {
    position: absolute;
    width: 52px;
    right: max(16px, 2.5vw);
    bottom: 18px;
    transform: rotate(32deg);
    opacity: 0.9;
  }
  @media (max-width: 899px) {
    .page-hero :global(.ph-paws) {
      width: 34px;
      right: 14px;
      bottom: 12px;
      opacity: 0.7;
    }
  }
  .hero-inner {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .hero-text :global(.btn-row) {
    margin-top: 28px;
  }
  .hero-logo {
    position: relative;
    display: grid;
    place-items: center;
  }
  .hero-logo::before {
    content: '';
    position: absolute;
    width: min(420px, 90%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(70 181 156 / 0.14) 0%, rgb(49 133 197 / 0.08) 45%, transparent 70%);
  }
  .hero-logo img {
    position: relative;
    width: clamp(180px, 20vw, 300px);
    height: auto;
    filter: drop-shadow(0 24px 40px rgb(49 133 197 / 0.22));
  }
  @media (max-width: 899px) {
    .hero-logo {
      display: none;
    }
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.8rem);
    max-width: 18ch;
  }
</style>
