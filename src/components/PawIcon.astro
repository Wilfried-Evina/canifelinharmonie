---
// Empreinte unique (chien ou chat), mêmes formes que les traces animées (PawTrail).
interface Props {
  animal?: 'dog' | 'cat';
  size?: number;
  color?: string;
  class?: string;
}
const { animal = 'dog', size = 18, color = 'currentColor', class: cls } = Astro.props;
---

<svg class:list={['paw-icon', cls]} width={size} height={size} viewBox="0 0 32 32" fill={color} aria-hidden="true">
  {
    animal === 'cat' ? (
      <>
        <g transform="translate(16 17) scale(1.12) translate(-16 -17)">
          <circle cx="7.6" cy="13.4" r="3.1" />
          <circle cx="12.4" cy="8.6" r="3.2" />
          <circle cx="19.6" cy="8.6" r="3.2" />
          <circle cx="24.4" cy="13.4" r="3.1" />
          <path d="M16 15.4c-4 0-8.2 3.4-8.2 7.2 0 2.1 1.3 3.6 3.1 3.9 1.1.2 1.9-.3 2.6-1 .7 1 1.5 1.7 2.5 1.7s1.8-.7 2.5-1.7c.7.7 1.5 1.2 2.6 1 1.8-.3 3.1-1.8 3.1-3.9 0-3.8-4.2-7.2-8.2-7.2z" />
        </g>
      </>
    ) : (
      <>
        <ellipse cx="7" cy="13" rx="3" ry="4" transform="rotate(-24 7 13)" />
        <ellipse cx="12.6" cy="6.4" rx="3.2" ry="4.3" transform="rotate(-8 12.6 6.4)" />
        <ellipse cx="19.4" cy="6.4" rx="3.2" ry="4.3" transform="rotate(8 19.4 6.4)" />
        <ellipse cx="25" cy="13" rx="3" ry="4" transform="rotate(24 25 13)" />
        <path d="M16 14.2c-4.4 0-9.2 6.4-9.2 10.4 0 3 2.6 4.6 5.2 4.1 1.5-.3 2.6-1 4-1s2.5.7 4 1c2.6.5 5.2-1.1 5.2-4.1 0-4-4.8-10.4-9.2-10.4z" />
      </>
    )
  }
</svg>

<style>
  .paw-icon {
    flex: none;
  }
</style>
