---
// Page Chien – mise en scène inspirée des pages produit Apple :
// sous-navigation collante, hero géant, galerie « points forts », grands chiffres,
// tuiles, section sombre, étapes, comparatif de tarifs, bandeau photo défilant.
import { Image, getImage } from 'astro:assets';
import videoPoster from '../assets/photos/namak-medical-training-video.jpg';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PawIcon from '../components/PawIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { consultations, site } from '../data/site';
import { dogPhotos, photos } from '../data/photos';

// Textes : « Textes Pages Web – Version Corrigée » (Brigitte, nov. 2026)
const highlights = [
  {
    photo: photos.seanceEducation,
    alt: 'Brigitte en séance d’éducation avec trois Léonbergs assis devant elle dans un pré',
    label: 'Éducation',
    title: 'Apprenez à apprendre à votre chien.',
    text: 'Des méthodes douces et adaptées, du chiot au chien âgé.',
    pos: '50% 40%',
  },
  {
    photo: photos.sociabilisation,
    alt: 'Plusieurs Léonbergs se rencontrent calmement dans un pré',
    label: 'Comportement',
    title: 'Retrouver autonomie et bien-être.',
    text: 'Un accompagnement qui tient compte de son histoire et de ses émotions.',
    pos: '50% 55%',
  },
  {
    photo: photos.namakVeto,
    alt: 'Namak, Léonberg, sur un plateau d’équilibre pendant une séance chez la vétérinaire',
    label: 'Soins coopératifs',
    title: 'Des soins, avec son accord.',
    text: 'Brossage, médicaments, voiture, vétérinaire : des soins vécus sans stress.',
    pos: '50% 45%',
  },
  {
    photo: photos.namakChiot,
    alt: 'Namak, chiot Léonberg, tire la langue dans l’herbe',
    label: 'Nouveaux arrivants',
    title: 'Bien accueillir un nouveau membre.',
    text: 'Chiot, chien adulte ou chat : une cohabitation préparée et sécurisée.',
    pos: '50% 35%',
  },
  {
    photo: photos.kiara,
    alt: 'Kiara, berger noir et feu, souriante dans un pré fleuri',
    label: 'Conseils avant adoption',
    title: 'Le bon chien, pour la bonne famille.',
    text: 'Mode de vie, temps, budget, expérience : on prépare l’adoption ensemble.',
    pos: '50% 30%',
  },
];

// Repères affichés en grand sous « Une approche respectueuse »
const proofs = [
  { value: '1 h 30', label: 'pour la première consultation, à domicile ou à Genève centre' },
  { value: '48 h', label: 'ouvrables au maximum pour vous répondre' },
  { value: 'OSAV', label: 'Diplôme d’éducatrice canin certifié depuis 2021' },
  { value: 'SCAV', label: 'Éducatrice canin agréée (TMC)' },
];

// Vidéo de la section soins coopératifs : image affichée avant la lecture
const poster = await getImage({ src: videoPoster, width: 1280, format: 'webp' });

// Prestations, dans l'ordre de la vie du chien (photo affichée à côté de chaque texte)
const services = [
  {
    name: 'Avant l’adoption',
    title: 'Choisir en connaissance de cause.',
    text: 'Mode de vie, projets, environnement, temps, budget, expérience : on prépare ensemble l’accueil de votre futur compagnon, pour une relation équilibrée dès le départ.',
    img: photos.kiara,
    alt: 'Kiara, berger noir et feu, souriante dans un pré fleuri',
    pos: '50% 30%',
  },
  {
    name: 'Éducation',
    title: 'Des bases solides et durables.',
    text: 'Apprenez à apprendre à votre chien grâce à des méthodes douces et adaptées. Du chiot au chien âgé, je vous aide à comprendre ses signaux, son langage et ses besoins.',
    img: photos.seanceEducation,
    alt: 'Brigitte en séance d’éducation avec trois Léonbergs assis devant elle',
    pos: '55% 50%',
  },
  {
    name: 'Nouveaux arrivants & vie de famille',
    title: 'Une cohabitation harmonieuse.',
    text: 'Un nouveau membre, humain ou animal, demande de nouvelles habitudes. Je vous aide à préparer et sécuriser l’arrivée d’un chien, d’un chat ou d’un chiot.',
    img: photos.entente,
    alt: 'Un chien et un chat couchés l’un contre l’autre sur un tapis',
    pos: '40% 50%',
  },
  {
    name: 'Arrivée d’un bébé',
    title: 'Préserver l’équilibre du foyer.',
    text: 'Préparez sereinement l’arrivée d’un enfant : on adapte l’environnement et on accompagne votre chien dans cette transition.',
    img: photos.leonbergsRepos,
    alt: 'Quatre Léonbergs couchés calmement à l’ombre dans un jardin',
    pos: '40% 60%',
  },
  {
    name: 'Comportement',
    title: 'Comprendre avant d’agir.',
    text: 'La modification comportementale aide le chien à retrouver autonomie et bien-être, en tenant compte de son histoire, de ses émotions et, si pertinent, de sa race.',
    img: photos.namakBouvier,
    alt: 'Namak, Léonberg, et Maybe, Bouvier bernois, calmes côte à côte sur un chemin',
    pos: '55% 55%',
  },
  {
    name: 'Soins coopératifs',
    title: 'Des soins vécus en toute sérénité.',
    text: 'Brossage, médicaments, montée en voiture, soins vétérinaires : des apprentissages progressifs et respectueux, quel que soit son âge ou son état de santé.',
    img: photos.namakVeto,
    alt: 'Namak en séance de physiothérapie, calme sur un plateau d’équilibre',
    pos: '25% 60%',
    link: { href: '#soins-cooperatifs', label: 'Voir en images' },
  },
];

const steps = [
  { n: '01', title: 'Votre demande', text: `Vous remplissez le formulaire. Je vous réponds sous ${site.responseTime}.` },
  { n: '02', title: 'La consultation', text: 'Environ 1 h 30 chez vous : histoire, quotidien, observation de votre chien.' },
  { n: '03', title: 'Le rapport', text: 'Un plan d’action écrit, transmis à votre vétérinaire si vous le souhaitez.' },
  { n: '04', title: 'Le suivi', text: 'Des cours dès 45 minutes pour progresser pas à pas, à votre rythme.' },
];

const reasons = [
  { icon: 'home', title: 'Chez vous', text: 'Là où votre chien vit et où les difficultés apparaissent.' },
  { icon: 'shield', title: 'Certifiée OSAV, agréée SCAV', text: 'Éducatrice canin diplômée OSAV, agréée SCAV (TMC) et formée en continu.' },
  { icon: 'file', title: 'Rapport écrit', text: 'Un plan clair, partageable avec votre vétérinaire.' },
  { icon: 'heart', title: 'Sans contrainte', text: 'Des méthodes respectueuses, fondées sur la coopération.' },
] as const;

// Bandeau défilant : la liste est doublée pour une boucle continue
const marquee = [...dogPhotos, ...dogPhotos];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}/chien#service`,
  name: 'Éducation canine, comportement du chien et soins coopératifs à Genève',
  serviceType: 'Éducation et comportement canin',
  description:
    'Consultations en comportement canin, cours d’éducation du chiot au chien adulte, soins coopératifs (medical training) et conseils avant adoption à domicile à Genève.',
  provider: { '@id': `${site.url}/#business` },
  areaServed: ['Genève', 'Grand-Lancy', 'Lancy', 'Carouge', 'Onex', 'Plan-les-Ouates', 'Bernex', 'Veyrier', 'Vernier', 'Canton de Genève'],
  offers: consultations.chien.map((c) => ({
    '@type': 'Offer',
    name: c.name,
    description: c.features.join(' · '),
    price: c.price,
    priceCurrency: 'CHF',
    url: `${site.url}/chien/#tarifs`,
  })),
};
---

<Base
  title="Éducatrice canin à Genève : éducation et comportement du chien"
  description="Éducation canine et comportement du chien à Genève : chiot, réactivité, arrivée d’un bébé, soins coopératifs. Éducatrice agréée SCAV, à domicile."
  image={photos.leonbergs}
  imageAlt="Quatre Léonbergs assis côte à côte dans l’herbe à Genève – Canifelin Harmonie"
  schema={[serviceSchema]}
>
  <!-- ================= HERO ================= -->
  <section class="ch-hero" id="top">
    <div class="container ch-hero-head">
      <p class="ch-kicker">Éducation & comportement canin · Genève</p>
      <h1 class="ch-title">
        <span class="t-line">Comprenez votre chien.</span>
        <span class="t-line grad">Améliorez son bien-être.</span>
      </h1>
      <p class="ch-sub">
        Éducatrice canin agréée SCAV (TMC) et intervenante en comportement. Des méthodes respectueuses, adaptées à chaque chien.
      </p>
      <div class="ch-actions btn-row">
        <a href="/contact?animal=chien" class="btn">Prendre rendez-vous</a>
        <a href="#tarifs" class="btn btn--ghost">Voir les tarifs</a>
      </div>
      <p class="ch-price">Première consultation à domicile <strong>CHF 120</strong> · Cours dès 45 min <strong>CHF 60</strong></p>
    </div>

    <div class="ch-hero-media">
      <Image
        src={photos.leonbergs}
        alt="Ladakh et trois autres Léonbergs assis côte à côte dans l’herbe, devant un vieux mur de pierre"
        widths={[800, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ================= POINTS FORTS ================= -->
  <section class="ch-highlights" id="points-forts">
    <div class="container">
      <h2 class="ch-h2 reveal">Les points forts.</h2>
    </div>

    <div class="hl" data-hl>
      <ul class="hl-track" data-hl-track>
        {
          highlights.map((h, i) => (
            <li class="hl-card" data-hl-card={i}>
              <Image src={h.photo} alt={h.alt} widths={[600, 1000, 1600]} sizes="(max-width: 700px) 88vw, 1000px" style={`object-position:${h.pos}`} loading={i < 2 ? 'eager' : 'lazy'} />
              <div class="hl-copy">
                <p class="hl-label">{h.label}</p>
                <h3 class="hl-title">{h.title}</h3>
                <p class="hl-text">{h.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="container hl-controls">
        <div class="hl-dots" role="tablist" aria-label="Points forts">
          {
            highlights.map((h, i) => (
              <button class="hl-dot" type="button" role="tab" aria-label={h.label} data-hl-dot={i}>
                <span></span>
              </button>
            ))
          }
          <button class="hl-play" type="button" data-hl-play aria-label="Mettre en pause">
            <Icon name="pause" size={16} class="i-pause" />
            <Icon name="play" size={16} class="i-play" />
          </button>
        </div>
        <div class="hl-paddles">
          <button type="button" class="hl-paddle" data-hl-prev aria-label="Précédent"><Icon name="chevron-left" size={22} /></button>
          <button type="button" class="hl-paddle" data-hl-next aria-label="Suivant"><Icon name="chevron-right" size={22} /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= APPROCHE & REPÈRES (cocon clair) ================= -->
  <section class="ch-ethos">
    <div class="container">
      <div class="ethos-cocoon">
        <div class="ethos-copy reveal">
          <h2 class="ethos-title">
            Une approche respectueuse.<br />
            <em class="ethos-accent">Fondée sur la science.</em>
          </h2>
          <p class="ethos-sub">
            Mon objectif : vous aider à construire une relation harmonieuse avec votre chien, basée sur la
            confiance, la compréhension et le respect mutuel.
          </p>
        </div>

        <ul class="ethos-proofs">
          {
            proofs.map((p) => (
              <li class="ethos-proof reveal">
                <span class="proof-value">{p.value}</span>
                <span class="proof-label">{p.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= PRESTATIONS (tuiles) ================= -->
  <section class="ch-bento-section" id="prestations">
    <div class="container">
      <div class="ch-section-head center reveal">
        <h2 class="ch-h2">Tout ce dont il a besoin.<br /><span class="muted-line">À chaque étape de sa vie.</span></h2>
      </div>

      <div class="svc" data-svc>
        <!-- Ordinateur : grande photo fixe qui change selon la prestation lue -->
        <div class="svc-stage" aria-hidden="true">
          {
            services.map((sv, i) => (
              <Image
                src={sv.img}
                alt=""
                widths={[700, 1100]}
                sizes="(max-width: 899px) 1px, 46vw"
                class:list={['svc-photo', { 'is-active': i === 0 }]}
                style={`object-position:${sv.pos}`}
                data-svc-photo={i}
              />
            ))
          }
        </div>

        <ol class="svc-list">
          {
            services.map((sv, i) => (
              <li class:list={['svc-item', { 'is-active': i === 0 }]} data-svc-item={i}>
                <div class="svc-thumb">
                  <Image src={sv.img} alt={sv.alt} widths={[500, 900]} sizes="(min-width: 900px) 1px, 92vw" style={`object-position:${sv.pos}`} />
                </div>
                <p class="svc-name">{sv.name}</p>
                <h3>{sv.title}</h3>
                <p class="svc-text">{sv.text}</p>
                {sv.link && <a class="svc-link" href={sv.link.href}>{sv.link.label}</a>}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="ch-center reveal">
        <a href="/contact?animal=chien" class="btn">Réserver ma consultation</a>
      </div>
    </div>
  </section>

  <!-- ================= SOINS COOPÉRATIFS (sombre, photos) ================= -->
  <section class="ch-care" id="soins-cooperatifs">
    <div class="container">
      <p class="ch-kicker reveal">Entraînement médical</p>
      <h2 class="ch-statement reveal">
        Des soins.<br /><span class="grad">Avec son accord.</span>
      </h2>
      <p class="ch-statement-sub reveal">
        Les soins coopératifs ne veulent pas dire que votre chien adore être soigné. Cela signifie que
        vous lui demandez son accord et que vous collaborez avec lui, avec son consentement.
      </p>

      <div class="care-film reveal">
        <video
          class="care-video"
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster.src}
          aria-label="Vidéo : Namak, Léonberg, reste couché calmement sur la table pendant un soin chez la vétérinaire"
          data-care-video
        >
          <source src="/videos/namak-medical-training-480.mp4" type="video/mp4" media="(max-width: 700px)" />
          <source src="/videos/namak-medical-training-720.mp4" type="video/mp4" />
        </video>
        <p class="care-film-caption">Chez la vétérinaire : Namak reste couché, en confiance.</p>
        <button type="button" class="care-toggle" aria-label="Mettre la vidéo en pause" data-care-toggle>
          <Icon name="pause" size={16} class="i-pause" />
          <Icon name="play" size={16} class="i-play" />
        </button>
      </div>

      <div class="care-grid">
        <figure class="care-item reveal">
          <Image src={photos.namakLunettes} alt="Namak porte des lunettes de protection pendant une séance de physiothérapie" widths={[500, 900]} sizes="(max-width: 700px) 78vw, 30vw" />
          <figcaption>Lunettes de protection en physiothérapie.</figcaption>
        </figure>
        <figure class="care-item reveal">
          <Image src={photos.namakTable} alt="Namak couché calmement sur une table d’examen" widths={[500, 900]} sizes="(max-width: 700px) 78vw, 30vw" />
          <figcaption>Sur la table d’examen, tout en calme.</figcaption>
        </figure>
        <figure class="care-item reveal">
          <Image src={photos.namakMaison} alt="Namak à la maison devant le matériel de soin préparé sur une table : thermomètre, flacon, récompenses" widths={[500, 900]} sizes="(max-width: 700px) 78vw, 30vw" />
          <figcaption>On s’entraîne d’abord à la maison.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= DÉROULEMENT ================= -->
  <section class="ch-steps-section" id="deroulement">
    <div class="container">
      <div class="ch-section-head center reveal">
        <h2 class="ch-h2">Simple.<br /><span class="muted-line">Du premier message au suivi.</span></h2>
      </div>
      <!-- Un chemin relie les étapes et se remplit au défilement ; une patte marque chaque étape -->
      <ol class="ch-steps">
        {
          steps.map((s) => (
            <li class="step reveal">
              <span class="step-mark" aria-hidden="true">
                <PawIcon animal="dog" size={20} />
              </span>
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="ch-center reveal">
        <a href="/contact?animal=chien" class="btn">Faire ma demande</a>
      </div>
    </div>
  </section>

  <!-- ================= TARIFS (comparatif) ================= -->
  <section class="ch-pricing" id="tarifs">
    <div class="container">
      <div class="ch-section-head center reveal">
        <h2 class="ch-h2">Quelle formule pour votre chien ?</h2>
      </div>
      <div class="compare">
        {
          consultations.chien.map((c) => (
            <article class="compare-col reveal">
              <span class="compare-icon">
                <PawIcon animal="dog" size={34} color="#3185c5" />
              </span>
              <h3>{c.name}</h3>
              <p class="compare-duration">{c.duration}</p>
              <p class="compare-price">CHF {c.price}</p>
              <ul>
                {c.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a href={`/contact?animal=chien&prestation=${c.name.startsWith('Cours') ? 'education' : 'comportement'}`} class="btn">Réserver</a>
            </article>
          ))
        }
        <article class="compare-col reveal">
          <span class="compare-icon">
            <PawIcon animal="dog" size={34} color="#3185c5" />
          </span>
          <h3>Garde à domicile</h3>
          <p class="compare-duration">30 à 60 min par visite</p>
          <p class="compare-price">dès CHF 30</p>
          <ul>
            <li>Promenades et visites chez vous</li>
            <li>Nouvelles et photos chaque jour</li>
            <li>Bilan de garde écrit</li>
          </ul>
          <a href="/garde-a-domicile#chiens" class="btn btn--ghost">Voir les offres</a>
        </article>
      </div>
      <p class="compare-note reveal">
        Déplacements inclus dans un rayon de {site.radiusKm} km autour de {site.base}, puis {site.kmFee}.
        Paiement par virement, TWINT ou espèces.
      </p>
    </div>
  </section>

  <!-- ================= RAISONS ================= -->
  <section class="ch-reasons">
    <div class="container">
      <div class="ch-section-head center reveal">
        <h2 class="ch-h2">Tant de raisons<br /><span class="muted-line">de faire le premier pas.</span></h2>
      </div>
      <ul class="reasons">
        {
          reasons.map((r) => (
            <li class="reason reveal">
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= BANDEAU PHOTO DÉFILANT ================= -->
  <section class="ch-marquee" aria-label="Quelques compagnons à quatre pattes">
    <div class="container">
      <h2 class="ch-h2 reveal">Quelques compagnons<br /><span class="muted-line">à quatre pattes.</span></h2>
    </div>
    <div class="marquee">
      <ul class="marquee-track">
        {
          marquee.map((p, i) => (
            <li aria-hidden={i >= dogPhotos.length ? 'true' : undefined}>
              <figure>
                <Image src={p.src} alt={i >= dogPhotos.length ? '' : p.alt} widths={[340, 680]} sizes="340px" loading="lazy" />
                <figcaption>{p.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Prêt·e à offrir à votre chien une vie plus sereine ?"
    text="Une vie en harmonie au sein de votre foyer, en entente avec vous ? Contactez-moi pour faire le premier pas vers une relation plus harmonieuse."
  />
</Base>

<script>
  // ---------- Galerie « Points forts » : défilement automatique, points de progression, flèches
  const hl = document.querySelector<HTMLElement>('[data-hl]');
  if (hl) {
    const track = hl.querySelector<HTMLElement>('[data-hl-track]')!;
    const cards = [...hl.querySelectorAll<HTMLElement>('[data-hl-card]')];
    const dots = [...hl.querySelectorAll<HTMLButtonElement>('[data-hl-dot]')];
    const playBtn = hl.querySelector<HTMLButtonElement>('[data-hl-play]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 6000;
    let index = 0;
    let playing = !reduce;
    let inView = false;
    let timer: number | undefined;

    const setActive = (i: number) => {
      index = i;
      dots.forEach((d, j) => {
        d.classList.toggle('is-active', j === i);
        d.setAttribute('aria-selected', String(j === i));
      });
      cards.forEach((c, j) => c.classList.toggle('is-current', j === i));
      // relance l'animation de remplissage du point actif
      hl.classList.remove('is-running');
      void hl.offsetWidth;
      if (playing && inView) hl.classList.add('is-running');
    };
    const goTo = (i: number, smooth = true) => {
      const target = cards[(i + cards.length) % cards.length];
      track.scrollTo({ left: target.offsetLeft - cards[0].offsetLeft, behavior: smooth && !reduce ? 'smooth' : 'auto' });
      setActive((i + cards.length) % cards.length);
      schedule();
    };
    const schedule = () => {
      window.clearTimeout(timer);
      if (playing && inView) timer = window.setTimeout(() => goTo(index + 1), DURATION);
    };
    const setPlaying = (p: boolean) => {
      playing = p;
      hl.classList.toggle('is-paused', !p);
      playBtn.setAttribute('aria-label', p ? 'Mettre en pause' : 'Lire');
      setActive(index);
      schedule();
    };

    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    hl.querySelector('[data-hl-prev]')!.addEventListener('click', () => goTo(index - 1));
    hl.querySelector('[data-hl-next]')!.addEventListener('click', () => goTo(index + 1));
    playBtn.addEventListener('click', () => setPlaying(!playing));

    // Défilement manuel (doigt, trackpad) : on met à jour le point actif
    let scrollTimer: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const x = track.scrollLeft;
          let best = 0;
          cards.forEach((c, j) => {
            if (Math.abs(c.offsetLeft - cards[0].offsetLeft - x) < Math.abs(cards[best].offsetLeft - cards[0].offsetLeft - x)) best = j;
          });
          if (best !== index) {
            setActive(best);
            schedule();
          }
        }, 120);
      },
      { passive: true },
    );
    track.addEventListener('pointerdown', () => playing && setPlaying(false));

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        setActive(index);
        schedule();
      },
      { threshold: 0.4 },
    ).observe(hl);
    if (reduce) hl.classList.add('is-paused');
    setActive(0);
  }

  // Prestations : la photo fixe suit la prestation au centre de l'écran
  const svc = document.querySelector<HTMLElement>('[data-svc]');
  if (svc) {
    const items = [...svc.querySelectorAll<HTMLElement>('[data-svc-item]')];
    const shots = [...svc.querySelectorAll<HTMLElement>('[data-svc-photo]')];
    const wide = window.matchMedia('(min-width: 900px)');
    let current = 0;
    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      items.forEach((el, k) => el.classList.toggle('is-active', k === i));
      shots.forEach((el, k) => el.classList.toggle('is-active', k === i));
    };
    // la prestation active est celle qui croise le milieu de l'écran
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!wide.matches) return;
      const mid = window.innerHeight / 2;
      let best = 0;
      items.forEach((el, k) => {
        if (el.getBoundingClientRect().top <= mid) best = k;
      });
      setActive(best);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    items.forEach((el, i) => {
      el.addEventListener('pointerenter', (ev) => wide.matches && ev.pointerType === 'mouse' && setActive(i));
    });
    // précharge les photos de la scène pour un fondu sans trou
    shots.forEach((el) => el.setAttribute('loading', 'eager'));
    svc.classList.add('is-live');
    update();
  }

  // Vidéo soins coopératifs : lecture seulement quand elle est visible, bouton pause,
  // et pas de lecture automatique si l'utilisateur préfère moins d'animations
  const careVideo = document.querySelector<HTMLVideoElement>('[data-care-video]');
  const careToggle = document.querySelector<HTMLButtonElement>('[data-care-toggle]');
  if (careVideo && careToggle) {
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = calm;
    const sync = () => {
      const paused = careVideo.paused;
      careToggle.classList.toggle('is-paused', paused);
      careToggle.setAttribute('aria-label', paused ? 'Lire la vidéo' : 'Mettre la vidéo en pause');
    };
    careVideo.addEventListener('play', sync);
    careVideo.addEventListener('pause', sync);
    careToggle.addEventListener('click', () => {
      if (careVideo.paused) {
        userPaused = false;
        careVideo.play().catch(() => {});
      } else {
        userPaused = true;
        careVideo.pause();
      }
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !userPaused) careVideo.play().catch(() => {});
          else if (!e.isIntersecting) careVideo.pause();
        },
        { threshold: 0.35 },
      ).observe(careVideo);
    }
    sync();
  }
</script>

