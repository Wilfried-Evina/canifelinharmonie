---
// Page Qui suis-je – même mise en scène que les pages Chien, Chat, Garde et Tarifs.
// Fonds par paires : crème (hero + histoire), sable (formations + engagements), puis bandeau final crème.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { formations, formationsNote, site } from '../data/site';
import { photos } from '../data/photos';

// Les trois compagnons de Brigitte, dans l'ordre où ils sont arrivés
const companions = [
  { photo: photos.diablotine, name: 'Diablotine', what: 'chatte tricolore', line: 'C’est elle qui m’a choisie.', alt: 'Diablotine, chatte tricolore, sur son arbre à chat', pos: '45% 50%' },
  { photo: photos.olympeaDiablotine, name: 'Olympea', what: 'Maine Coon', line: 'Un nom de déesse antique.', alt: 'Olympea, Maine Coon argentée, allongée sur un lit', pos: '72% 55%' },
  { photo: photos.namakChapeau, name: 'Namak', what: 'Léonberg', line: 'Deux années de réflexion avant son arrivée.', alt: 'Namak, Léonberg, coiffé d’un chapeau en papier, la langue sortie', pos: '50% 40%' },
];

const commitments = [
  { title: 'Zéro contrainte', text: 'Aucune méthode coercitive. Observer, écouter, s’adapter, faire bouger sans brusquer : des méthodes respectueuses, fondées sur la coopération.' },
  { title: 'Sans jugement', text: 'Chaque situation a son histoire. Je vous écoute avec bienveillance et sans culpabilisation.' },
  { title: 'En réseau', text: 'Je travaille en lien avec les vétérinaires, vétérinaires comportementalistes et ostéopathes quand la situation le demande.' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/qui-suis-je#person`,
  name: site.owner,
  url: `${site.url}/qui-suis-je/`,
  image: new URL(photos.brigitte.src, site.url).href,
  jobTitle: 'Éducatrice canin agréée SCAV (TMC) et intervenante en comportement canin et félin',
  worksFor: { '@id': `${site.url}/#business` },
  knowsAbout: [
    'Éducation canine',
    'Comportement canin',
    'Comportement félin',
    'Éthologie appliquée',
    'Soins coopératifs (medical training)',
    'Garde d’animaux à domicile',
  ],
  hasCredential: formations.map((f) => ({
    '@type': 'EducationalOccupationalCredential',
    name: `${f.title} (${f.org}, ${f.year})`,
  })),
};
---

<Base
  title="Brigitte Trachsel, éducatrice canin agréée SCAV & comportement à Genève"
  description="Brigitte Trachsel, éducatrice canin agréée SCAV (TMC), certifiée OSAV et intervenante en comportement chien et chat à Genève : parcours, diplômes et approche fondée sur l’éthologie."
  image={photos.brigitte}
  imageAlt="Brigitte Trachsel entourée de ses trois Léonbergs à Genève"
  schema={[personSchema]}
>
  <!-- ================= HERO ================= -->
  <section class="ch-hero q-hero" id="top">
    <div class="container ch-hero-head">
      <p class="ch-kicker">Qui suis-je</p>
      <h1 class="ch-title">
        <span class="t-line">Brigitte Trachsel.</span>
        <span class="t-line grad">Au service du lien.</span>
      </h1>
      <p class="ch-sub">
        Éducatrice canin agréée SCAV (TMC) et intervenante en comportement canin et félin : un
        accompagnement basé sur l’éthologie et la relation humain-animal.
      </p>
      <div class="ch-actions btn-row">
        <a href="/contact" class="btn">Prendre rendez-vous</a>
        <a href="#formations" class="btn btn--ghost">Mes formations</a>
      </div>
    </div>

    <!-- Brigitte au centre, sa famille à quatre pattes de chaque côté -->
    <div class="container q-trip">
      <figure class="q-side q-left">
        <Image src={photos.trio} alt="Namak, Léonberg, regarde Diablotine et Olympea installées sur leur arbre à chat" widths={[500, 900]} sizes="(max-width: 700px) 30vw, 28vw" loading="lazy" />
      </figure>
      <figure class="q-main">
        <Image src={photos.brigitte} alt="Brigitte Trachsel debout dans un jardin avec trois Léonbergs assis à ses pieds" widths={[500, 800, 1024]} sizes="(max-width: 700px) 90vw, 36vw" loading="eager" fetchpriority="high" />
      </figure>
      <figure class="q-side q-right">
        <Image src={photos.namakChiot} alt="Namak, chiot Léonberg de 3 mois, tire la langue dans l’herbe" widths={[500, 900]} sizes="(max-width: 700px) 30vw, 28vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ================= HISTOIRE ================= -->
  <section class="q-story" id="histoire">
    <div class="container">
      <div class="q-row">
      <p class="q-opening reveal">
        Je pourrais commencer par « Depuis toute petite, j’aime les animaux », mais ce serait trop
        simple.
      </p>

      <div class="q-prose reveal">
        <p>
          J’ai grandi dans un environnement où la violence ordinaire envers les animaux n’avait pas sa
          place. Un coup de laisse, une pichenette sur la truffe ou une prise par le cou n’étaient pas
          des gestes anodins, mais des attitudes inacceptables. Mon père m’a transmis un respect du
          vivant profondément ancré : observer, écouter, s’adapter, faire bouger sans brusquer. J’ai
          grandi avec ce regard.
        </p>
        <p>
          Puis Diablotine, une chatte tricolore, m’a choisie. Olympea, une Maine Coon au nom de déesse
          antique, a suivi. Et enfin Namak, mon Léonberg, est arrivé après deux années de réflexion et
          de préparation. Chacun d’eux continue de m’apprendre, chaque jour, sur la relation, l’autre
          et moi-même.
        </p>
      </div>
      </div>

      <ul class="q-companions">
        {
          companions.map((c) => (
            <li class="q-card reveal">
              <Image src={c.photo} alt={c.alt} widths={[400, 800, 1100]} sizes="(max-width: 899px) 78vw, 30vw" style={`object-position:${c.pos}`} />
              <div class="q-card-copy">
                <p class="q-card-what">{c.what}</p>
                <h3>{c.name}</h3>
                <p class="q-card-line">{c.line}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="q-row q-row--rev">
      <div class="q-prose reveal">
        <p>
          Ces expériences personnelles nourrissent directement ma pratique professionnelle : une
          approche individualisée, respectueuse des émotions et attentive à l’histoire de chaque
          binôme humain-animal.
        </p>
        <p>
          J’ai suivi plusieurs cursus certifiants en éducation, comportement et soins coopératifs,
          complétés par des stages en refuge, pension, élevage et cabinet vétérinaire. Je poursuis
          régulièrement ma formation afin de rester à jour des avancées scientifiques en éthologie et
          en comportement animal.
        </p>
      </div>

      <blockquote class="q-quote reveal">
        Après avoir accompagné l’humain dans des contextes d’urgence et de tension, j’ai choisi de
        l’accompagner autrement : <span class="grad">dans la douceur du lien, au rythme des pattes, des
        silences et des regards partagés.</span>
      </blockquote>
      </div>
    </div>
  </section>

  <!-- ================= FORMATIONS ================= -->
  <section class="q-formations" id="formations">
    <div class="container">
      <div class="q-head reveal">
        <h2 class="ch-h2">Une formation continue.<br /><span class="muted-line">Et exigeante.</span></h2>
        <p class="q-lead">
          Le comportement animal est une science qui évolue. Je me forme régulièrement auprès de
          spécialistes reconnus en Suisse, en France et au Québec.
        </p>
      </div>
      <ol class="q-timeline">
        {
          formations.map((f) => (
            <li class="reveal">
              <span class="q-year">{f.year}</span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.org}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="q-note reveal">{formationsNote}</p>
    </div>
  </section>

  <!-- ================= ENGAGEMENTS ================= -->
  <section class="q-commit">
    <div class="container">
      <div class="q-head reveal">
        <h2 class="ch-h2">Mes engagements.<br /><span class="muted-line">Ce à quoi vous attendre.</span></h2>
      </div>
      <ul class="q-cols">
        {
          commitments.map((c) => (
            <li class="reveal">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Faisons connaissance" />
</Base>

<style>
  /* ============================================================
     Typographie « Apple »
     ============================================================ */
  .grad {
    background: linear-gradient(100deg, #3185c5 10%, #3a9db4 50%, #46b59c 90%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ch-kicker {
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.15rem);
    font-weight: 600;
    color: var(--teal-700);
    margin: 0 0 14px;
  }
  .ch-h2 {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin: 0;
    text-wrap: balance;
  }
  .muted-line {
    display: inline-block;
    text-wrap: balance;
    color: #8a97a3;
  }
  .ch-section-head {
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .ch-section-head.center {
    text-align: center;
  }
  .ch-center {
    display: flex;
    justify-content: center;
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* ============================================================
     Hero
     ============================================================ */
  .ch-hero {
    padding-top: clamp(48px, 7vw, 96px);
    background: var(--cream);
    overflow: hidden;
  }
  .ch-hero-head {
    text-align: center;
  }
  .ch-title {
    font-size: clamp(2.7rem, 1.2rem + 6vw, 6.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0 auto 24px;
    max-width: 22ch;
  }
  .t-line {
    display: block;
  }
  .ch-sub {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.45rem);
    color: var(--muted);
    max-width: 40ch;
    margin: 0 auto 32px;
    line-height: 1.45;
  }
  .ch-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ch-price {
    margin: 22px 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .ch-price strong {
    color: var(--teal-950);
    font-weight: 600;
  }
  .ch-hero-media {
    margin-top: clamp(40px, 6vw, 80px);
    height: clamp(340px, 60vw, 860px);
    overflow: hidden;
    clip-path: inset(0 var(--gutter) round 28px);
  }
  .ch-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* Entrée en douceur du titre au chargement */
  @media (prefers-reduced-motion: no-preference) {
    .t-line,
    .ch-sub,
    .ch-actions,
    .ch-price,
    .ch-kicker {
      animation: rise 0.9s var(--ease) both;
    }
    .ch-hero-head .ch-kicker {
      animation-delay: 0s;
    }
    .t-line:nth-child(1) {
      animation-delay: 0.08s;
    }
    .t-line:nth-child(2) {
      animation-delay: 0.2s;
    }
    .ch-sub {
      animation-delay: 0.32s;
    }
    .ch-actions {
      animation-delay: 0.42s;
    }
    .ch-price {
      animation-delay: 0.5s;
    }
    .ch-hero-media {
      animation: media-in 1.2s var(--ease) 0.25s both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes media-in {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.97);
    }
  }
  /* L'image s'ouvre en pleine largeur au défilement (navigateurs compatibles) */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ch-hero-media {
        animation:
          media-in 1.2s var(--ease) 0.25s both,
          media-open linear both;
        animation-timeline: auto, scroll(root);
        animation-range:
          normal,
          0px 640px;
      }
      .ch-hero-media :global(img) {
        animation: media-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0px 900px;
      }
    }
  }
  @keyframes media-open {
    to {
      clip-path: inset(0 0 round 0);
    }
  }
  @keyframes media-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }


  /* ============================================================
     Qui suis-je
     ============================================================ */
  .q-head {
    margin-bottom: clamp(36px, 5vw, 64px);
    text-align: center;
  }
  .q-lead {
    margin: 20px auto 0;
    max-width: 56ch;
    color: var(--muted);
    font-size: clamp(1.03rem, 0.98rem + 0.26vw, 1.18rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Hero : triptyque, portrait au centre */
  .q-trip {
    margin-top: clamp(40px, 6vw, 80px);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    align-items: center;
    gap: clamp(10px, 2vw, 28px);
  }
  .q-trip figure {
    margin: 0;
    overflow: hidden;
    border-radius: clamp(16px, 2.4vw, 32px);
  }
  .q-trip :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Téléphone : uniquement le portrait de Brigitte, en grand (pas de chevauchement) */
  @media (max-width: 699px) {
    .q-trip {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .q-side {
      display: none;
    }
    .q-main {
      width: min(100%, 420px);
    }
  }
  .q-main {
    aspect-ratio: 3 / 4;
    box-shadow: 0 40px 80px -44px rgb(15 44 61 / 0.45);
  }
  .q-side {
    aspect-ratio: 3 / 4;
    width: 100%;
    max-height: 78%;
    align-self: center;
  }
  .q-left :global(img) {
    object-position: 30% 50%;
  }
  .q-right :global(img) {
    object-position: 50% 40%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .q-trip figure {
      animation: media-in 1.1s var(--ease) both;
    }
    .q-main {
      animation-delay: 0.2s !important;
    }
    .q-left {
      animation-delay: 0.35s !important;
    }
    .q-right {
      animation-delay: 0.45s !important;
    }
  }

  /* Histoire : lecture confortable, une colonne centrée */
  .q-story {
    background: var(--cream);
    padding-block: clamp(72px, 9vw, 128px) clamp(88px, 11vw, 150px);
  }
  /* Ordinateur : grande phrase d'un côté, texte de l'autre, sur toute la largeur */
  .q-row {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .q-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(56px, 7vw, 128px);
    }
    .q-row--rev {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    .q-row .q-opening,
    .q-row .q-quote {
      text-align: left;
      max-width: none;
      margin: 0;
    }
    .q-row .q-prose {
      max-width: none;
      margin: 0;
    }
  }
  .q-opening {
    margin: 0 auto;
    max-width: 22ch;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--teal-950);
    text-wrap: balance;
  }
  .q-prose {
    margin: 0 auto;
    max-width: 62ch;
    color: var(--ink);
    font-size: clamp(1.04rem, 1rem + 0.2vw, 1.15rem);
    line-height: 1.75;
  }
  .q-prose p {
    margin: 0 0 1.2em;
  }
  /* Les 3 compagnons : grandes cartes photo, texte posé sur l'image (comme les « points forts ») */
  .q-companions {
    list-style: none;
    margin: clamp(48px, 6vw, 96px) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
  }
  .q-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: clamp(20px, 2.4vw, 32px);
    background: var(--teal-900);
  }
  .q-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .q-card:hover :global(img) {
      transform: scale(1.04);
    }
  }
  .q-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(8 22 32 / 0) 45%, rgb(8 22 32 / 0.8) 100%);
    pointer-events: none;
  }
  .q-card-copy {
    position: absolute;
    z-index: 1;
    left: clamp(18px, 2.4vw, 32px);
    right: clamp(18px, 2.4vw, 32px);
    bottom: clamp(18px, 2.4vw, 32px);
    color: var(--white);
    text-align: left;
  }
  .q-card-what {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-style: italic;
    color: #9fe0cf;
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.15rem);
  }
  .q-card h3 {
    margin: 0 0 6px;
    color: var(--white);
    font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .q-card-line {
    margin: 0;
    color: rgb(255 255 255 / 0.85);
    font-size: clamp(0.92rem, 0.88rem + 0.2vw, 1.05rem);
    line-height: 1.45;
  }
  .q-card:nth-child(2) {
    transition-delay: 0.08s;
  }
  .q-card:nth-child(3) {
    transition-delay: 0.16s;
  }
  /* Téléphone / tablette : cartes qui défilent au doigt, bord à bord */
  @media (max-width: 899px) {
    .q-companions {
      display: flex;
      gap: 14px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 6px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .q-companions::-webkit-scrollbar {
      display: none;
    }
    .q-card {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }

  .q-quote {
    margin: 0 auto;
    max-width: 30ch;
    padding: 0;
    border: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.5rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--teal-950);
    text-wrap: balance;
  }

  /* Mobile / tablette : texte et frise centrés, comme les titres */
  @media (max-width: 999px) {
    .q-prose {
      text-align: center;
    }
  }
  @media (max-width: 699px) {
    .q-timeline li {
      text-align: center;
      justify-items: center;
    }
  }

  /* Formations : frise, années en grand */
  .q-formations {
    background: var(--sand);
    padding-block: clamp(88px, 11vw, 150px) clamp(48px, 6vw, 80px);
  }
  .q-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(21 61 85 / 0.14);
  }
  @media (min-width: 1000px) {
    /* 2 colonnes de 3 formations, lues de haut en bas */
    .q-timeline {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      column-gap: clamp(56px, 7vw, 128px);
    }
  }
  .q-timeline li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
    padding: 24px 0;
    border-bottom: 1px solid rgb(21 61 85 / 0.14);
  }
  @media (min-width: 700px) {
    .q-timeline li {
      grid-template-columns: 200px minmax(0, 1fr);
      align-items: baseline;
      gap: 32px;
    }
  }
  .q-year {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    background: linear-gradient(100deg, #3185c5, #46b59c);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
  }
  .q-timeline h3 {
    margin: 0 0 4px;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
    font-weight: 500;
  }
  .q-timeline p {
    margin: 0;
    color: var(--muted);
  }
  .q-note {
    margin: 28px auto 0;
    max-width: 60ch;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--muted);
  }

  /* Engagements : 3 colonnes séparées par des filets */
  .q-commit {
    background: var(--sand);
    padding-block: clamp(48px, 6vw, 80px) clamp(88px, 11vw, 150px);
  }
  .q-cols {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
