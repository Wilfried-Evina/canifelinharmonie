---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Image OpenGraph / Twitter spécifique à la page (ImageMetadata ou chemin relatif) */
  image?: string | ImageMetadata;
  imageAlt?: string;
  /** Désactiver l'indexation (ex. page 404) */
  noindex?: boolean;
  /** Données structurées JSON-LD additionnelles propres à la page */
  schema?: Record<string, unknown>[];
}
const {
  title,
  description = site.description,
  image = '/og-image.jpg',
  imageAlt = `${site.name} – ${site.owner}, éducatrice canin agréée SCAV et intervenante en comportement chien et chat à Genève`,
  noindex = false,
  schema = [],
} = Astro.props;
const fullTitle = title.includes('Canifelin') ? title : `${title} | Canifelin Harmonie`;
const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(cleanPath, site.url).href;
const resolvedOg =
  typeof image === 'string'
    ? image
    : (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 68 })).src;
const ogImage = new URL(resolvedOg, site.url).href;

const breadcrumbNames: Record<string, string> = {
  '/chien': 'Éducation & comportement canin',
  '/chat': 'Comportement félin',
  '/garde-a-domicile': 'Garde à domicile',
  '/tarifs': 'Tarifs',
  '/qui-suis-je': 'Qui suis-je',
  '/contact': 'Contact & rendez-vous',
  '/liens-utiles': 'Liens utiles',
  '/conditions-d-utilisation': 'Conditions d’utilisation',
  '/politique-de-confidentialite': 'Politique de confidentialité',
};

const breadcrumbSchema =
  cleanPath !== '/' && !noindex
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Accueil',
            item: site.url,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: breadcrumbNames[cleanPath] ?? title,
            item: canonical,
          },
        ],
      }
    : null;

const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${site.url}/#business`,
  name: site.name,
  alternateName: `${site.owner} – ${site.name}`,
  description: site.description,
  slogan: site.tagline,
  url: site.url,
  email: site.email,
  telephone: site.phoneIntl,
  image: ogImage,
  logo: new URL('/logo.svg', site.url).href,
  hasMap: site.mapsUrl,
  knowsLanguage: ['fr-CH', 'fr'],
  founder: {
    '@type': 'Person',
    '@id': `${site.url}/qui-suis-je#person`,
    name: site.owner,
    jobTitle: 'Éducatrice canin agréée SCAV (TMC) et intervenante en comportement canin et félin',
    url: `${site.url}/qui-suis-je`,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: site.base,
    addressRegion: 'GE',
    addressCountry: 'CH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 46.1837,
    longitude: 6.1189,
  },
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: 46.1837,
      longitude: 6.1189,
    },
    geoRadius: 15000,
  },
  areaServed: [
    { '@type': 'City', name: 'Genève' },
    { '@type': 'City', name: 'Grand-Lancy' },
    { '@type': 'City', name: 'Lancy' },
    { '@type': 'City', name: 'Carouge' },
    { '@type': 'City', name: 'Onex' },
    { '@type': 'City', name: 'Plan-les-Ouates' },
    { '@type': 'City', name: 'Bernex' },
    { '@type': 'City', name: 'Confignon' },
    { '@type': 'City', name: 'Veyrier' },
    { '@type': 'City', name: 'Vernier' },
    { '@type': 'City', name: 'Meyrin' },
    { '@type': 'City', name: 'Chêne-Bougeries' },
    { '@type': 'City', name: 'Thônex' },
    { '@type': 'AdministrativeArea', name: 'Canton de Genève' },
    // Consultations pour chats en visioconférence
    { '@type': 'Country', name: 'Suisse' },
    { '@type': 'Country', name: 'France' },
  ],
  priceRange: 'CHF 30 – CHF 130',
  paymentAccepted: 'Virement bancaire, TWINT, Espèces',
  currenciesAccepted: 'CHF',
};
---

<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr-CH" href={canonical} />
    <link rel="alternate" hreflang="fr" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="geo.region" content="CH-GE" />
    <meta name="geo.placename" content="Grand-Lancy, Genève" />
    <meta name="theme-color" content="#fbf5ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      // Origine du visiteur (1re page vue, site d'où il vient, campagne utm), gardée le temps de la visite
      // et jointe uniquement à une demande envoyée via le formulaire de contact.
      try {
        if (!sessionStorage.getItem('ch-origin')) {
          const q = new URLSearchParams(location.search);
          const utm = ['utm_source', 'utm_medium', 'utm_campaign']
            .map((k) => (q.get(k) ? `${k.slice(4)}=${q.get(k)}` : ''))
            .filter(Boolean)
            .join(', ');
          let ref = '';
          try {
            ref = document.referrer && new URL(document.referrer).host !== location.host ? document.referrer : '';
          } catch {}
          sessionStorage.setItem(
            'ch-origin',
            JSON.stringify({ landing: location.pathname, referrer: ref || 'direct', utm: utm || '-' }),
          );
        }
      } catch {}

      // Apparition douce des sections au défilement
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
